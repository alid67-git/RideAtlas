<!-- Declares RideAtlas as a template-based (androidx.car.app) car app,
     required alongside the com.google.android.gms.car.application
     meta-data entry in AndroidManifest.xml for Android Auto to find it. -->
<automotiveApp>
    <uses name="template" />
</automotiveApp>
