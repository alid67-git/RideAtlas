<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Live ride recording: fine-grained location plus a foreground service
         with a persistent notification, so tracking keeps running while the
         app is minimized. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Without this, Android's Settings > App info > Permissions > Location
         screen never even offers an "Allow all the time" choice for this
         app - it caps out at "only while using", which the OS is free to
         suspend once the app isn't in the foreground, foreground service or
         not. (An earlier version of this file assumed the foreground
         service alone was enough to skip requesting this; real-device
         testing on Android proved that assumption wrong - the recorded
         track gained a gap for exactly as long as the screen stayed
         locked.) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Many OEM Android skins (MIUI, ColorOS, OneUI, ...) throttle or kill
         GPS updates once the screen turns off, even for a proper foreground
         service, unless the app is exempted from battery optimization. This
         lets RecordScreen prompt the user for that exemption directly (see
         MainActivity.kt's battery method channel) instead of only working
         while the screen stays on. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Lets the in-app "Güncelle" button hand a downloaded APK straight to
         the system installer (see lib/services/update_checker.dart), rather
         than only opening a browser download the user has to find and tap
         themselves afterward. This app is distributed via GitHub releases,
         not the Play Store, so requesting it is fine - Play Store policy is
         the reason most apps avoid it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- After finishing a recording, offers to attach any photos/videos the
         gallery gained during the ride (see lib/services/gallery_scan.dart)
         - needs read access to the device's media library. READ_MEDIA_IMAGES
         and READ_MEDIA_VIDEO cover Android 13+; READ_MEDIA_VISUAL_USER_SELECTED
         covers Android 14+'s "select photos" partial-access grant; the
         maxSdkVersion=32 permission (added by the photo_manager plugin
         itself) covers everything older. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <!-- Without this, Android 10+ strips GPS coordinates from a photo's
         metadata before handing it to us, so a gallery-scanned photo would
         always look location-less even when it has a geotag. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION"/>
    <!-- Required by the androidx.car.app library for RecordingScreen's live
         map (CarMapRenderer): NAVIGATION_TEMPLATES to use NavigationTemplate
         at all, ACCESS_SURFACE to actually get a drawable Surface for it. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES"/>
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE"/>
    <application
        android:label="RideAtlas"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- geolocator starts this as a location foreground service while
             recording. Merge the type here so Android 14+ always sees
             foregroundServiceType=location on the final merged manifest. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            android:foregroundServiceType="location"
            tools:node="merge" />
        <!-- Our own recording FGS: collects GPS natively so screen-off /
             Doze can't freeze the track when the Flutter engine sleeps. -->
        <service
            android:name=".RecordingLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />
        <!-- Android Auto: lets a recording already running on the phone be
             viewed and controlled (start/pause/resume/finish) from the
             car's own screen. See android/app/src/main/kotlin/.../car/. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Required by the androidx.car.app library - without it the
             Android Auto host can't tell this is a valid car app and just
             silently omits it from the app grid (no error anywhere). -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <service
            android:name=".car.RideAtlasCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!-- RideAtlas doesn't do turn-by-turn navigation, but the
                     NAVIGATION category is what unlocks the general-purpose
                     Pane/Grid templates this screen uses (the other public
                     categories - parking/charging/IoT - restrict to their
                     own narrow POI templates). Fine for a sideloaded,
                     personal-use app; a Play Store listing would need to
                     either add real navigation or pick a different fit. -->
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Open GPX / KML / KMZ from a file manager ("Şununla aç").
                 Multiple <data> of the same attribute are OR'd; scheme and
                 mimeType together are AND'd - so (content|file) + any of
                 the track MIME types. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="application/gpx+xml"/>
                <data android:mimeType="application/gpx"/>
                <data android:mimeType="application/vnd.google-earth.kml+xml"/>
                <data android:mimeType="application/vnd.google-earth.kmz"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="text/xml"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <!-- Extension-based matching for file managers that only send
                 */* (or omit a useful MIME). pathPattern is AND'd with the
                 other <data> attrs, so each extension needs its own filter. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:host="*" android:mimeType="*/*"
                    android:pathPattern=".*\\.gpx"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.gpx"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:host="*" android:mimeType="*/*"
                    android:pathPattern=".*\\.kml"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.kml"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:host="*" android:mimeType="*/*"
                    android:pathPattern=".*\\.kmz"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.kmz"/>
            </intent-filter>
            <!-- Share-sheet "Send to RideAtlas". -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/gpx+xml"/>
                <data android:mimeType="application/gpx"/>
                <data android:mimeType="application/vnd.google-earth.kml+xml"/>
                <data android:mimeType="application/vnd.google-earth.kmz"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="text/xml"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
